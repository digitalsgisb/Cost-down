GOOGLE_CLIENT_ID=
GOOGLE_SPREADSHEET_ID=
# Absolute path to your service-account JSON key, kept outside the project.
# On Google Cloud, Application Default Credentials can replace this file.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: restrict sign-in to a verified Workspace hosted domain.
GOOGLE_WORKSPACE_DOMAIN=
PORT=3001
AUDIT_DIR=data
# Map Google account immutable 'sub' IDs to roles. Not email addresses.
DASHBOARD_USERS={}
# Example bootstrap Admin: {"YOUR_GOOGLE_SUB":{"role":"Admin","email":"YOUR_GOOGLE_EMAIL"}}


