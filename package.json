{
  "name": "company-cost-down-v2",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 0.0.0.0",
    "dev:client": "vite --host 0.0.0.0 --configLoader runner",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
